{
  "expo": {
    "name": "GameTrace",
    "slug": "gametrace-app",
    "scheme": "gametrace",
    "version": "0.5.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/df4f365e-1c8a-4a74-bb3a-d59dc2d562d2"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.gametrace.app",
      "backgroundColor": "#14110f",
      "adaptiveIcon": {
        "backgroundColor": "#14110f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Aplikacja używa mikrofonu do nagrywania sesji głosowych.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Aplikacja potrzebuje dostępu do zdjęć, aby ustawić własną okładkę gry."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "project": "gametrace-mobile",
          "organization": "rafa-scibor"
        }
      ],
      "expo-secure-store",
      "expo-image",
      "expo-web-browser",
      "expo-asset",
      "expo-localization",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14110f",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "style": "light"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "df4f365e-1c8a-4a74-bb3a-d59dc2d562d2"
      }
    },
    "owner": "zyrafel"
  }
}
