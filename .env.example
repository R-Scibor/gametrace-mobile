# Discord application (OAuth2). Public values — inlined into the JS bundle at build time.
EXPO_PUBLIC_DISCORD_CLIENT_ID=
# Bot-install URL shown when a Discord login returns needs_server_join.
EXPO_PUBLIC_DISCORD_INVITE_URL=
# Shared secret for the dev-only POST /auth/login (X-Dev-Login-Secret header).
# Must match backend DEV_LOGIN_SECRET. Leave EMPTY here — set it only in a local
# .env (gitignored). A build with it set exposes username login and inlines the
# secret into the bundle, so never distribute such a build. Empty -> username
# login is hidden and the endpoint returns 404.
EXPO_PUBLIC_DEV_LOGIN_SECRET=
